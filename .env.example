# LunaFlow Environment Configuration Template

# Flask Backend
SECRET_KEY=lunaflow-replace-this-with-a-secure-random-secret-key-32-bytes
JWT_SECRET_KEY=lunaflow-replace-this-with-a-secure-jwt-secret-key-32-bytes
PORT=5000
FRONTEND_URL=http://localhost:5173


# Database (Supabase PostgreSQL for production/cloud, SQLite for local dev)
# Use the Supabase Session Pooler URI (IPv4-compatible, port 5432) from Dashboard -> Connect -> Session Pooler:
# postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Or Direct connection (IPv6-only unless IPv4 add-on is enabled):
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///lunaflow.db

# Supabase Project Metadata (optional reference)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=support@lunaflow.app

# Email Provider (console, resend, sendgrid, smtp)
MAIL_PROVIDER=console
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@lunaflow.app
