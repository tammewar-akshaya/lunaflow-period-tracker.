# LunaFlow Environment Configuration Template

# Flask Backend
SECRET_KEY=lunaflow-replace-this-with-a-secure-random-secret-key-32-bytes
JWT_SECRET_KEY=lunaflow-replace-this-with-a-secure-jwt-secret-key-32-bytes
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL for production, SQLite for local dev)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///lunaflow.db

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=support@lunaflow.app

# Email Provider (console, resend, sendgrid, smtp)
MAIL_PROVIDER=console
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@lunaflow.app
